# Leave Supabase settings blank for local SQLite and filesystem storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative for deployments using the Supabase delphi-storage Edge Function.
DELPHI_WORKER_KEY=
PUBLISH_SECRET=

# Optional OpenAI-compatible accompaniment. Use a model that supports JSON mode.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Optional bearer token for moderator deletions.
MODERATION_TOKEN=
# Set only behind a proxy that appends or overwrites X-Forwarded-For.
TRUST_PROXY=0
HOST=127.0.0.1
PORT=4177
